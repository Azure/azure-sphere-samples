{
    "name": "Azure Sphere Sample - Modernized",
    "dockerFile": "Dockerfile",
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined",
        "--privileged",
        "--device-cgroup-rule=c 189:* rmw",
        "-v", "/dev/bus/usb:/dev/bus/usb:rw"
    ],
    "mounts": [
        "source=/dev,target=/dev,type=bind,consistency=cached"
    ],
    "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
    },
    "extensions": [
        "ms-vscode.azure-sphere-tools",
        "ms-vscode.azure-sphere-tools-ui"
    ],
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y usbutils",
    "remoteUser": "root"
}
